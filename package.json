{
  "name": "@dziri/messenger-mobile",
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "prestart": "node scripts/sync-inbox.mjs",
    "preweb": "node scripts/sync-inbox.mjs",
    "sync:inbox": "node scripts/sync-inbox.mjs",
    "sync:inbox:watch": "node scripts/sync-inbox.mjs --watch",
    "bundle:inbox": "node scripts/sync-inbox.mjs && expo export --platform all --output-dir dist-inbox",
    "preview:inbox": "node scripts/preview-inbox.mjs",
    "start": "node scripts/dev-inbox.mjs --dev-client",
    "web": "node scripts/dev-inbox.mjs --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:domain": "node --test tests/domain.test.mjs",
    "test": "node --test tests/domain.test.mjs tests/inbox.test.mjs tests/access.test.mjs",
    "typecheck:consumer": "tsc --noEmit --project tsconfig.consumer.json",
    "typecheck": "tsc --noEmit --project tsconfig.consumer.json",
    "lint": "eslint App.tsx app.config.ts src/messenger.tsx src/access.ts src/dziri src/inbox src/theme/tailwind.config.ts",
    "check:consistency": "node scripts/check-dziri-consistency.mjs",
    "bundle:android": "expo export --platform android --output-dir dist-android",
    "bundle:ios": "expo export --platform ios --output-dir dist-ios"
  },
  "dependencies": {
    "@convex-dev/auth": "0.0.95",
    "@rails/actioncable": "7.2.300",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.10.1",
    "@shopify/flash-list": "2.3.2",
    "convex": "1.36.1",
    "expo": "57.0.7",
    "expo-constants": "57.0.6",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-localization": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.5",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "3.4.12",
    "twrnc": "4.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/rails__actioncable": "6.1.11",
    "@types/react": "~19.2.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "http-proxy": "1.18.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@kesha-antonov/react-native-action-cable"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "@kesha-antonov/react-native-action-cable",
          "@notifee/react-native",
          "react-native-audio-recorder-player",
          "react-native-file-viewer",
          "react-native-file-viewer",
          "react-native-fs",
          "react-native-snackbar",
          "@react-native-community/blur",
          "react-native-autoheight-webview",
          "redux-persist",
          "ffmpeg-kit-react-native",
          "@chatwoot/markdown-to-txt",
          "@chatwoot/react-native-widget",
          "@chatwoot/utils",
          "camelcase",
          "camelcase-keys",
          "cross-env",
          "date-fns",
          "lodash",
          "reactotron-redux",
          "tailwindcss",
          "use-deep-compare-effect",
          "diff",
          "string.prototype.matchall",
          "snakecase-keys"
        ],
        "listUnknownPackages": true
      }
    }
  },
  "pnpm": {
    "patchedDependencies": {
      "expo-modules-jsi@57.0.3": "patches/expo-modules-jsi@57.0.3.patch",
      "react-native-reanimated@4.5.5": "patches/react-native-reanimated@4.5.5.patch"
    },
    "overrides": {
      "@expo/dom-webview": "57.0.1",
      "form-data": "^4.0.4",
      "node-forge": "1.4.0",
      "glob": "^10.5.0",
      "markdown-it": "^12.3.2",
      "js-yaml": "4.3.2",
      "storybook": "8.6.17",
      "@expo/cli>minimatch": "3.1.4",
      "@expo/metro-config>minimatch": "3.1.4",
      "@expo/fingerprint>minimatch": "3.1.4",
      "@typescript-eslint/typescript-estree>minimatch": "9.0.7",
      "glob>minimatch": "9.0.7",
      "tar": "7.5.11",
      "on-headers": "1.1.0",
      "brace-expansion@>=5 <6": "5.0.12",
      "@xmldom/xmldom": "0.8.15",
      "postcss-selector-parser@>=7 <8": "7.1.6",
      "shell-quote": "1.11.0",
      "yaml": "2.8.3",
      "nanoid@>=3 <4": "3.3.18",
      "browserslist": "4.28.7",
      "brace-expansion@>=1 <2": "1.1.21",
      "baseline-browser-mapping": "2.11.0",
      "@babel/core": "7.29.6",
      "ws@>=7 <8": "7.5.11",
      "source-map-js": "1.2.2",
      "picomatch@>=2 <3": "2.3.2",
      "ws@>=8 <9": "8.21.0",
      "compression": "1.8.2",
      "postcss@>=8 <9": "8.5.23",
      "postcss-selector-parser@>=6 <7": "6.1.3",
      "image-size@>=2 <3": "2.0.3"
    }
  },
  "engines": {
    "node": ">=22.18"
  }
}
